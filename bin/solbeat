#!/bin/sh
set -eu

SOURCE=$0
while [ -L "$SOURCE" ]; do
    SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
    SOURCE=$(readlink "$SOURCE")
    case "$SOURCE" in
        /*) ;;
        *) SOURCE=$SOURCE_DIR/$SOURCE ;;
    esac
done
BIN_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
REPO_ROOT=$(CDPATH= cd -P -- "$BIN_DIR/.." && pwd)

if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$REPO_ROOT/src:$PYTHONPATH"
else
    export PYTHONPATH="$REPO_ROOT/src"
fi

unset SOLBEAT_CONFIG SOLBEAT_HOME
exec python3 -m solbeat --config "$REPO_ROOT/config/solbeat.toml" "$@"
